# KEY NAMES ONLY — plaintext template for credentials/development.yml.enc.
# Do not put real secrets in this example file.
#
# Rails loads config/credentials/development.yml.enc in development (replaces
# credentials.yml.enc for that env). Decrypt with gitignored
# config/credentials/development.key — never commit the key.
#
# Sources of key names (no secret values):
#   - featured_in config/storage.yml → credentials dig(:r2, …)
#   - RecordingStudio Artifacts → dig(:recording_studio_artifacts, :cdn, …)
#   - Attachable direct host → dig(:recording_studio_attachable, :direct_url_host)
#
# Because env-specific credentials replace the shared blob, also include
# secret_key_base (copy from the shared dummy credentials when you edit).

secret_key_base:

# featured_in Active Storage R2
r2:
  access_key_id:
  secret_access_key:
  endpoint:
  bucket:

# RecordingStudio Artifacts CDN (same shape as Artifacts docs/credentials.cdn.example.yml)
recording_studio_artifacts:
  cdn:
    subdomain:
    domain:
    path_prefix: recording_studio_artifacts
    public_base_url:
    r2_account_id:
    r2_access_key_id:
    r2_secret_access_key:
    r2_bucket:
    r2_endpoint:
    r2_region: auto
    cloudflare_zone_id:
    cloudflare_api_token:

# Attachable public custom-domain host (DirectUrl)
recording_studio_attachable:
  direct_url_host:
