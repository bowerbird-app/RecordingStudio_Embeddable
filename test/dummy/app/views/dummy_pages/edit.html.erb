<% recording_studio_page_nav(
  title: "Edit Page",
  page_nav_back_url: root_path,
  page_nav_back_label: "Dummy embeddables",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit Page",
    subtitle: "Update page fields and compare output in publishable and embeddable views.",
    variant: :h1
  ) %>

  <%= form_with url: dummy_page_path(@page), method: :patch, class: "space-y-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "title",
      label: "Page name",
      value: @page.title,
      placeholder: "Enter a page name"
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "description",
      label: "Description",
      value: @page.description,
      rows: 6,
      placeholder: "Enter page description"
    ) %>

    <%= render FlatPack::Button::Component.new(text: "Save page", style: :primary, size: :md, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, size: :md, href: root_path) %>
  <% end %>
</div>
