<% recording_studio_page_nav(
  title: "Add Page",
  page_nav_back_url: root_path,
  page_nav_back_label: "Dummy embeddables",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Add Page",
    subtitle: "Create a new page record and attach it to Recording Studio for embeddable testing.",
    variant: :h1
  ) %>

  <%= form_with url: dummy_pages_path, method: :post, class: "space-y-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "title",
      label: "Page name",
      value: @next_page_title,
      placeholder: "Enter a page name"
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "description",
      label: "Description",
      rows: 6,
      placeholder: "Enter page description"
    ) %>

    <%= render FlatPack::Button::Component.new(text: "Create page", style: :primary, size: :md, type: "submit") %>
  <% end %>
</div>
