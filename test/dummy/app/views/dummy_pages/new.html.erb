<% content_for :title, "Add Page" %>
<% content_for :subtitle, "Create a new page record and attach it to Recording Studio for embeddable testing." %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: root_path,
  back_tooltip: "Dummy embeddables",
  anchor_href: root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex w-full flex-col gap-6">

  <%= form_with url: dummy_pages_path, method: :post, class: "space-y-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "title",
      label: "Page name",
      value: @next_page_title,
      placeholder: "Enter a page name"
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "description",
      label: "Description",
      rows: 6,
      placeholder: "Enter page description"
    ) %>

    <%= render FlatPack::Button::Component.new(text: "Create page", style: :primary, size: :md, type: "submit") %>
  <% end %>
</div>
