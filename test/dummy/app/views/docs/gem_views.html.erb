<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Gem Views",
    subtitle: "Preview the default embed template and inspect shipped engine views.",
    variant: :h1
  ) %>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold">Default Embed Preview</h2>
    <p class="text-sm text-slate-600">
      Rendering <span class="font-mono"><%= @default_embed_template_path %></span> with preview data.
    </p>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <%= render template: "recording_studio_embeddable/embeds/default" %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold">Default Embed Source</h2>
    <pre class="overflow-x-auto rounded-lg border border-slate-200 bg-slate-950 p-4 text-sm text-slate-100"><code><%= @default_embed_source %></code></pre>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold">All Engine View Templates</h2>

    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% Array(@engine_views).each do |view_path| %>
        <%= render FlatPack::List::Item.new(icon: :eye) do %>
          <span><%= view_path %></span>
        <% end %>
      <% end %>
    <% end %>
  </section>
</div>
