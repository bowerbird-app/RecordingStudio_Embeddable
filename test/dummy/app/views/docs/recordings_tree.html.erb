<% content_for :title, "Recordings tree" %>
<% content_for :subtitle, "Active dummy-app recordings shown as a nested parent/child outline." %>
<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render "app_nav" %>

  <% if @recording_tree.any? %>
    <%= render FlatPack::Tree::Component.new(compact: true, class: "w-full") do |tree| %>
      <%= render_recording_tree_nodes(tree, @recording_tree) %>
    <% end %>
  <% else %>
    <%= render FlatPack::Card::Component.new do |card| %>
      <% card.body do %>
        <p class="text-sm text-(--surface-muted-content-color)">No active recordings found.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
