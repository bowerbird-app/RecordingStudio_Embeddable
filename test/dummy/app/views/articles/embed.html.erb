<div style="min-height:100%;padding:1rem;">
  <div style="width:100%;max-width:<%= embed_layout_css_value(:max_width) || '48rem' %>;">
    <article style="padding:<%= embed_layout_css_value(:padding_scale) || '1rem' %>;border:1px solid var(--surface-border-color, #e2e8f0);border-radius:<%= embed_layout_css_value(:radius_scale) || '0.375rem' %>;background:var(--surface-background-color, transparent);color:var(--surface-content-color, inherit)">
      <h1 style="margin:0 0 0.5rem;color:var(--color-primary, currentColor)"><%= @article.title %></h1>
      <p style="margin:0;color:var(--surface-muted-content-color, inherit)"><%= @article.description.presence || "No description provided." %></p>
    </article>
  </div>
</div>
