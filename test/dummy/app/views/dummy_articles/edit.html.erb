<% content_for :title, "Edit Article" %>
<% content_for :subtitle, "Update article fields and compare embeddable output behavior." %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: root_path,
  back_tooltip: "Dummy embeddables",
  anchor_href: root_path,
  anchor_tooltip: "Close"
) %>

<div class="flex w-full flex-col gap-6">

  <%= form_with url: dummy_article_path(@article), method: :patch, class: "space-y-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "title",
      label: "Article name",
      value: @article.title,
      placeholder: "Enter an article name"
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "description",
      label: "Description",
      value: @article.description,
      rows: 6,
      placeholder: "Enter article description"
    ) %>

    <%= render FlatPack::Button::Component.new(text: "Save article", style: :primary, size: :md, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, size: :md, href: root_path) %>
  <% end %>
</div>
