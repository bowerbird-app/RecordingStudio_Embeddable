<% recording_studio_page_nav(
  title: "Edit Article",
  page_nav_back_url: root_path,
  page_nav_back_label: "Dummy embeddables",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Edit Article",
    subtitle: "Update article fields and compare embeddable output behavior.",
    variant: :h1
  ) %>

  <%= form_with url: dummy_article_path(@article), method: :patch, class: "space-y-4" do %>
    <%= render FlatPack::TextInput::Component.new(
      name: "title",
      label: "Article name",
      value: @article.title,
      placeholder: "Enter an article name"
    ) %>

    <%= render FlatPack::TextArea::Component.new(
      name: "description",
      label: "Description",
      value: @article.description,
      rows: 6,
      placeholder: "Enter article description"
    ) %>

    <%= render FlatPack::Button::Component.new(text: "Save article", style: :primary, size: :md, type: "submit") %>
    <%= render FlatPack::Button::Component.new(text: "Cancel", style: :ghost, size: :md, href: root_path) %>
  <% end %>
</div>
