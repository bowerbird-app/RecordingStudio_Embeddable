<% recording_studio_page_nav(
  title: "Manage embeds",
  page_nav_anchor_url: root_path,
  page_nav_anchor_label: "Close"
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Manage embeds",
    subtitle: "Open the embed screens in a window. Full pages stay the same.",
    variant: :h1
  ) %>

  <% if @page_recording && @widget_recording %>
    <div class="flex flex-wrap items-center gap-3">
      <%= recording_studio_embeddable_management_modal(
        recording: @page_recording,
        tab: :styling,
        label: "Page embed"
      ) %>
      <%= recording_studio_embeddable_management_modal(
        recording: @widget_recording,
        tab: :floating,
        label: "Chat button",
        style: :secondary
      ) %>
    </div>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">Seed the dummy app, then open this page again.</p>
  <% end %>
</div>
