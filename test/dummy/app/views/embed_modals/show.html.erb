<% content_for :title, "Manage embeds" %>
<% content_for :subtitle, "Open the embed screens in a window. Full pages stay the same." %>
<% flat_pack_page_nav(round: true, style: :default, anchor_href: root_path, anchor_tooltip: "Close") %>

<div class="flex w-full flex-col gap-6">

  <% if @page_recording && @widget_recording %>
    <div class="flex flex-wrap items-center gap-3">
      <%= recording_studio_embeddable_management_modal(
        recording: @page_recording,
        tab: :styling,
        label: "Page embed"
      ) %>
      <%= recording_studio_embeddable_management_modal(
        recording: @widget_recording,
        tab: :floating,
        label: "Chat button",
        style: :secondary
      ) %>
    </div>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">Seed the dummy app, then open this page again.</p>
  <% end %>
</div>
