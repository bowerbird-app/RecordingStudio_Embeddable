# Optional alternative to config/local_r2.yml.
# Copy to .env.development.local (gitignored). KEY NAMES ONLY — no secret values in git.
#
# Attachable
ATTACHABLE_DIRECT_URL_HOST=

# Artifacts CDN (RecordingStudio Artifacts / featured_in ARTIFACT_CDN_* shape)
ARTIFACT_CDN_SUBDOMAIN=
ARTIFACT_CDN_DOMAIN=
ARTIFACT_CDN_PATH_PREFIX=recording_studio_artifacts
ARTIFACT_CDN_PUBLIC_BASE_URL=
ARTIFACT_CDN_R2_ACCOUNT_ID=
ARTIFACT_CDN_R2_ACCESS_KEY_ID=
ARTIFACT_CDN_R2_SECRET_ACCESS_KEY=
ARTIFACT_CDN_R2_BUCKET=
ARTIFACT_CDN_R2_ENDPOINT=
ARTIFACT_CDN_R2_REGION=auto
ARTIFACT_CDN_CLOUDFLARE_ZONE_ID=
ARTIFACT_CDN_CLOUDFLARE_API_TOKEN=

# Active Storage R2 aliases (featured_in credentials :r2 key names as ENV)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto

# Turn on Artifacts usage in the dummy when publishing to real R2
RECORDING_STUDIO_ARTIFACTS_ENABLED=true
