<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Embedded recording</title>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <style>
      .recording-studio-embed-layout {
        margin: 0;
        min-height: 100%;
        background: var(--rse-embed-background-color, transparent);
        color: var(--rse-embed-text-color, inherit);
        font-family: var(--rse-embed-font-family, inherit);
      }

      .recording-studio-embed-layout a {
        color: var(--rse-embed-accent-color, currentColor);
      }

      .recording-studio-embed-layout [data-recording-studio-embeddable="fallback"] {
        color: var(--rse-embed-text-color, inherit);
      }

      .recording-studio-embed-layout [data-recording-studio-embeddable="fallback"] p {
        color: var(--rse-embed-muted-text-color, inherit);
      }
    </style>
  </head>
  <body <%= tag.attributes(embed_layout_body_attributes) %>>
    <%= yield %>
  </body>
</html>
