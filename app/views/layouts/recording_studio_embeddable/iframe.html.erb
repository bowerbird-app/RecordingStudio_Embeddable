<!DOCTYPE html>
<html <%= tag.attributes(data: { theme: embed_document_theme }) %>>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="turbo-visit-control" content="reload">
    <title>Embedded recording</title>
    <%= render "recording_studio_embeddable/embeds/document_styles" %>
  </head>
  <body <%= tag.attributes(embed_layout_body_attributes) %>>
    <%= yield %>
  </body>
</html>
