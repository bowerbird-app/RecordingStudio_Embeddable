<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || "Embedded recording" %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Styling",
    subtitle: recordable_title,
    variant: :h1,
    large_subtitle: true
  ) %>

  <div class="flex flex-wrap items-center gap-3">
    <%= render FlatPack::Button::Component.new(
      text: "Save styling",
      style: :primary,
      size: :md,
      type: "submit",
      disabled: !@styling_editable
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Reset all",
      style: :secondary,
      size: :md,
      type: "button",
      disabled: !@styling_editable,
      data: { reset_styling_fields: true }
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Preview",
      style: :secondary,
      size: :md,
      url: preview_management_embed_path(@embed)
    ) %>
  </div>

  <% unless @styling_editable %>
    <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
      Custom styling is currently disabled for this embed. You can still review the resolved values below.
    </p>
  <% end %>

  <% if @styling_errors.present? %>
    <p role="alert" class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
      <%= @styling_errors.map { |field, message| "#{field.to_s.humanize} #{message}" }.join(", ") %>
    </p>
  <% end %>

  <%= form_with model: @embed, url: styling_management_embed_path(@embed), method: :patch, class: "space-y-4" do |_form| %>
    <input type="hidden" name="styling_scope" value="embed">

    <h2 class="text-base font-semibold">Embed overrides</h2>
    <div class="space-y-4">
      <% @styling_definitions.each do |key, definition| %>
        <% field_name = key.to_s %>
        <% current_value = @styling_overrides[field_name] %>
        <% resolved_value = @resolved_theme[field_name] %>

        <div class="space-y-2 pb-4 last:pb-0">
          <div class="flex flex-wrap items-center gap-2">
            <label for="embed_appearance_<%= field_name %>" class="text-sm font-medium"><%= definition[:label] %></label>
          </div>

          <% case definition[:type] %>
          <% when :enum %>
            <% if field_name == "font_family" %>
              <%= render FlatPack::Select::Component.new(
                name: "embed[appearance][#{field_name}]",
                label: "",
                options: @font_options.map { |font| { label: "#{font}  Aa", value: font } },
                value: current_value,
                id: "embed_appearance_font_family",
                placeholder: (resolved_value.present? ? "Inherit (#{resolved_value})" : "Inherit"),
                searchable: true,
                disabled: !@styling_editable
              ) %>
            <% else %>
              <%= render FlatPack::TextInput::Component.new(
                name: "embed[appearance][#{field_name}]",
                label: "#{definition[:label]} (#{Array(definition[:options]).join(', ')})",
                value: current_value,
                placeholder: "Inherit (#{resolved_value})"
              ) %>
            <% end %>
          <% when :color %>
            <div class="flex items-center gap-3 rounded-md border border-(--surface-border-color) bg-(--surface-background-color) px-3 py-2">
              <button
                type="button"
                class="flex h-10 w-12 items-center justify-center rounded-md"
                data-color-picker-trigger-name="embed[appearance][<%= field_name %>]"
                <%= "disabled" unless @styling_editable %>
              >
                <div
                  class="h-8 w-8 shrink-0 rounded-md border border-(--surface-border-color)"
                  data-color-preview-name="embed[appearance][<%= field_name %>]"
                  style="background-color: <%= current_value.presence || resolved_value %>"
                ></div>
              </button>

              <input
                type="text"
                name="embed[appearance][<%= field_name %>]"
                value="<%= current_value %>"
                placeholder="Inherit (<%= resolved_value %>)"
                class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm text-(--surface-content-color) outline-none placeholder:text-(--surface-muted-content-color)"
                <%= "disabled" unless @styling_editable %>
              >

              <input
                type="color"
                value="<%= current_value.presence || resolved_value %>"
                data-color-sync-name="embed[appearance][<%= field_name %>]"
                data-default-color="<%= resolved_value %>"
                class="sr-only"
                tabindex="-1"
                aria-hidden="true"
                <%= "disabled" unless @styling_editable %>
              >
            </div>
          <% when :integer %>
            <%= render FlatPack::TextInput::Component.new(
              name: "embed[appearance][#{field_name}]",
              label: "#{definition[:label]} (#{definition[:min]}-#{definition[:max]})",
              value: current_value,
              placeholder: "Inherit (#{resolved_value})"
            ) %>
          <% end %>
        </div>
      <% end %>
    </div>

  <% end %>

</div>

<script>
  const initializeStylingColorPickers = () => {
    const normalizeHex = (value) => {
      const trimmed = (value || "").trim();
      if (!/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(trimmed)) return null;

      if (trimmed.length === 4) {
        return `#${trimmed[1]}${trimmed[1]}${trimmed[2]}${trimmed[2]}${trimmed[3]}${trimmed[3]}`.toLowerCase();
      }

      return trimmed.toLowerCase();
    };

    document.querySelectorAll('input[type="color"][data-color-sync-name]').forEach((picker) => {
      if (picker.dataset.colorSyncBound === "true") return;
      picker.dataset.colorSyncBound = "true";

      const syncName = picker.dataset.colorSyncName;
      const form = picker.closest("form");
      if (!form) return;

      const target = form.querySelector(`input[name="${syncName}"]`);
      if (!target) return;
      const trigger = form.querySelector(`[data-color-picker-trigger-name="${syncName}"]`);

      const preview = form.querySelector(`[data-color-preview-name="${syncName}"]`);
      const applyPreview = (value) => {
        if (!preview) return;

        const normalized = normalizeHex(value) || normalizeHex(picker.value);
        if (normalized) preview.style.backgroundColor = normalized;
      };

      applyPreview(target.value);

      picker.addEventListener("input", () => {
        target.value = picker.value;
        applyPreview(picker.value);
      });

      if (trigger) {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          if (picker.disabled) return;

          picker.click();
        });
      }

      target.addEventListener("input", () => {
        const normalized = normalizeHex(target.value);
        if (!normalized) return;

        picker.value = normalized;
        applyPreview(normalized);
      });
    });
  };

  const initializeStylingReset = () => {
    document.querySelectorAll('button[data-reset-styling-fields="true"]').forEach((button) => {
      if (button.dataset.resetBound === "true") return;
      button.dataset.resetBound = "true";
      button.addEventListener("click", () => {
        const form = button.closest("form");
        if (!form) return;

        form.querySelectorAll('input[name^="embed[appearance]"]').forEach((input) => {
          input.value = "";
        });

        form.querySelectorAll('input[type="color"][data-default-color]').forEach((picker) => {
          picker.value = picker.dataset.defaultColor;

          const syncName = picker.dataset.colorSyncName;
          if (!syncName) return;

          const preview = form.querySelector(`[data-color-preview-name="${syncName}"]`);
          if (preview) {
            preview.style.backgroundColor = picker.dataset.defaultColor;
          }
        });
      });
    });
  };

  const initializeFontPreviewSelects = () => {
    const loadedFonts = new Set();
    const fontCssBase = "https://fonts.googleapis.com/css2";

    const ensureGoogleFontLoaded = (fontName) => {
      const family = (fontName || "").trim();
      if (!family) return;

      const key = family.toLowerCase();
      if (loadedFonts.has(key)) return;
      loadedFonts.add(key);

      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = `${fontCssBase}?family=${encodeURIComponent(family)}:wght@400;500;600&display=swap`;
      document.head.appendChild(link);
    };

    const applyPreview = (hiddenInputId) => {
      const hiddenInput = document.getElementById(hiddenInputId);
      if (!hiddenInput) return;

      const selectRoot = hiddenInput.closest('[data-controller="flat-pack--select"]');
      if (!selectRoot) return;

      const trigger = selectRoot.querySelector('[data-flat-pack--select-target="trigger"]');
      const triggerLabel = trigger?.querySelector('span');
      const optionsList = selectRoot.querySelector('[data-flat-pack--select-target="optionsList"]');
      const dropdown = selectRoot.querySelector('[data-flat-pack--select-target="dropdown"]');

      const applyCurrentValueToTrigger = () => {
        const selectedValue = (hiddenInput.value || "").trim();
        if (!triggerLabel) return;

        triggerLabel.style.fontFamily = selectedValue || "inherit";
        ensureGoogleFontLoaded(selectedValue);
      };

      selectRoot.querySelectorAll('[role="option"][data-value]').forEach((option) => {
        const fontValue = (option.dataset.value || "").trim();
        if (!fontValue) return;

        option.style.fontFamily = fontValue;
      });

      const loadVisibleOptionFonts = () => {
        if (!optionsList) return;

        optionsList.querySelectorAll('[role="option"][data-value]').forEach((option) => {
          const fontValue = (option.dataset.value || "").trim();
          if (!fontValue || option.style.display === "none") return;

          const optionTop = option.offsetTop;
          const optionBottom = optionTop + option.offsetHeight;
          const viewTop = optionsList.scrollTop;
          const viewBottom = viewTop + optionsList.clientHeight;
          const inView = optionBottom >= viewTop - 20 && optionTop <= viewBottom + 20;

          if (inView) ensureGoogleFontLoaded(fontValue);
        });
      };

      applyCurrentValueToTrigger();
      loadVisibleOptionFonts();

      if (selectRoot.dataset.fontPreviewBound !== "true") {
        selectRoot.dataset.fontPreviewBound = "true";

        selectRoot.addEventListener("click", () => {
          setTimeout(() => {
            applyCurrentValueToTrigger();
            loadVisibleOptionFonts();
          }, 0);
        });

        hiddenInput.addEventListener("change", () => {
          applyCurrentValueToTrigger();
        });

        optionsList?.addEventListener("scroll", () => {
          loadVisibleOptionFonts();
        });

        const searchInput = selectRoot.querySelector('[data-flat-pack--select-target="searchInput"]');
        searchInput?.addEventListener("input", () => {
          setTimeout(loadVisibleOptionFonts, 0);
        });

        const dropdownObserver = new MutationObserver(() => {
          if (dropdown && !dropdown.classList.contains("hidden")) {
            setTimeout(loadVisibleOptionFonts, 0);
          }
        });

        if (dropdown) {
          dropdownObserver.observe(dropdown, { attributes: true, attributeFilter: ["class"] });
        }
      }
    };

    applyPreview("embed_appearance_font_family");
  };

  document.addEventListener("turbo:load", initializeStylingColorPickers);
  document.addEventListener("DOMContentLoaded", initializeStylingColorPickers);
  document.addEventListener("turbo:load", initializeStylingReset);
  document.addEventListener("DOMContentLoaded", initializeStylingReset);
  document.addEventListener("turbo:load", initializeFontPreviewSelects);
  document.addEventListener("DOMContentLoaded", initializeFontPreviewSelects);
</script>
