<% disable_management_actions = local_assigns.fetch(:disable_management_actions, false) %>

<div class="flex flex-wrap items-center gap-2">
  <%= render FlatPack::Button::Component.new(
    text: t("recording_studio.embeddable.common.preview", default: "Preview"),
    style: :secondary,
    size: :md,
    href: preview_management_embed_path(@embed),
    data: { turbo: false }
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: t("recording_studio.embeddable.common.styling", default: "Styling"),
    style: :secondary,
    size: :md,
    href: disable_management_actions ? nil : styling_management_embed_path(@embed),
    type: "button",
    class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
    aria: (disable_management_actions ? { disabled: true } : {})
  ) %>
  <% if @embed.parent_recording.respond_to?(:floating_capable?) && @embed.parent_recording.floating_capable? %>
    <% floating_label = recording_studio_floating_label(@embed.parent_recording) %>
    <%= render FlatPack::Button::Component.new(
      text: t("recording_studio.embeddable.common.launcher", label: floating_label, default: "%{label}"),
      style: :secondary,
      size: :md,
      href: disable_management_actions ? nil : floating_management_embed_path(@embed),
      type: "button",
      class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
      aria: (disable_management_actions ? { disabled: true } : {})
    ) %>
  <% end %>
  <%= render FlatPack::Button::Component.new(
    text: t("recording_studio.embeddable.common.settings", default: "Settings"),
    style: :secondary,
    size: :md,
    href: disable_management_actions ? nil : settings_management_embed_path(@embed),
    type: "button",
    class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
    aria: (disable_management_actions ? { disabled: true } : {})
  ) %>
  <%= render FlatPack::Button::Component.new(
    text: t("recording_studio.embeddable.common.stats", default: "Stats"),
    style: :secondary,
    size: :md,
    href: disable_management_actions ? nil : stats_management_embed_path(@embed),
    type: "button",
    class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
    aria: (disable_management_actions ? { disabled: true } : {})
  ) %>
</div>
