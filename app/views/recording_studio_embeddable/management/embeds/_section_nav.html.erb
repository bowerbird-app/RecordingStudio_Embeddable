<% disable_management_actions = local_assigns.fetch(:disable_management_actions, false) %>
<% sections = [] %>
<% sections << {
  screen: :edit,
  text: t("recording_studio.embeddable.common.embed", default: "Embed"),
  disabled: false
} %>
<% sections << {
  screen: :preview,
  text: t("recording_studio.embeddable.common.preview", default: "Preview"),
  disabled: false
} %>
<% sections << {
  screen: :styling,
  text: t("recording_studio.embeddable.management.styling.title", default: "Style"),
  disabled: disable_management_actions
} %>
<% if @embed.parent_recording.respond_to?(:floating_capable?) && @embed.parent_recording.floating_capable? %>
  <% floating_label = recording_studio_floating_label(@embed.parent_recording) %>
  <% sections << {
    screen: :floating,
    text: t("recording_studio.embeddable.common.launcher", label: floating_label, default: "%{label}"),
    disabled: disable_management_actions
  } %>
<% end %>
<% sections << {
  screen: :settings,
  text: t("recording_studio.embeddable.common.settings", default: "Settings"),
  disabled: disable_management_actions
} %>
<% sections << {
  screen: :stats,
  text: t("recording_studio.embeddable.common.stats", default: "Stats"),
  disabled: disable_management_actions
} %>
<% sections.each do |section| %>
  <% register_page_nav(
    role: :secondary,
    component: recording_studio_embeddable_management_section_button(
      screen: section[:screen],
      text: section[:text],
      disabled: section[:disabled]
    )
  ) %>
<% end %>
