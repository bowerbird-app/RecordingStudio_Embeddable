<% recordable = @recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || t("recording_studio.embeddable.common.embedded_recording", default: "Embedded recording") %>
<% settings = @floating || @embed.floating_settings %>

<% recording_studio_page_nav(
  title: t("recording_studio.embeddable.management.floating.title", default: "Launcher"),
  page_nav_back_url: edit_management_embed_path(@embed),
  page_nav_back_label: t("recording_studio.embeddable.common.embed", default: "Embed"),
  page_nav_anchor_url: main_app.root_path,
  page_nav_anchor_label: t("recording_studio.embeddable.common.close", default: "Close")
) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: t("recording_studio.embeddable.management.floating.title", default: "Launcher"),
    subtitle: t("recording_studio.embeddable.management.floating.subtitle", default: "Colours come from Style."),
    variant: :h1
  ) %>

  <%= render "section_nav" %>

  <%= render FlatPack::Grid::Component.new(cols: 2) do %>
    <div>
      <%= form_with model: @embed, url: floating_management_embed_path(@embed), method: :patch, html: { id: "launcher-settings" } do %>
        <% if @embed.errors.any? %>
          <p role="alert"><%= @embed.errors.full_messages.to_sentence %></p>
        <% end %>

        <%= render FlatPack::Switch::Component.new(
          name: "embed[floating_enabled]",
          label: t("recording_studio.embeddable.management.floating.enabled", default: "Show the button"),
          checked: @embed.floating_enabled
        ) %>

        <%= render FlatPack::Select::Component.new(
          name: "embed[floating][position]",
          label: t("recording_studio.embeddable.management.floating.position", default: "Corner"),
          value: settings["position"],
          options: [
            [t("recording_studio.embeddable.management.floating.bottom_right", default: "Bottom right"), "bottom-right"],
            [t("recording_studio.embeddable.management.floating.bottom_left", default: "Bottom left"), "bottom-left"]
          ]
        ) %>

        <%= render FlatPack::NumberInput::Component.new(
          name: "embed[floating][edge_spacing]",
          label: t("recording_studio.embeddable.management.floating.edge_spacing", default: "Edge spacing"),
          help_text: t("recording_studio.embeddable.management.floating.edge_help", default: "Pixels from the corner."),
          value: settings["edge_spacing"],
          min: 0,
          max: 64,
          step: 1
        ) %>

        <%= render FlatPack::NumberInput::Component.new(
          name: "embed[floating][popup_width]",
          label: t("recording_studio.embeddable.management.floating.width", default: "Panel width"),
          value: settings["popup_width"],
          min: 280,
          max: 440,
          step: 1
        ) %>

        <%= render FlatPack::NumberInput::Component.new(
          name: "embed[floating][popup_height]",
          label: t("recording_studio.embeddable.management.floating.height", default: "Panel height"),
          value: settings["popup_height"],
          min: 360,
          max: 720,
          step: 1
        ) %>

        <%= render FlatPack::TextInput::Component.new(
          name: "embed[floating][icon_url]",
          label: t("recording_studio.embeddable.management.floating.icon", default: "Icon link"),
          help_text: t("recording_studio.embeddable.management.floating.icon_help", default: "An image you attached, or a host you allow."),
          value: settings["icon_url"]
        ) %>

        <%= render FlatPack::Button::Component.new(
          text: t("recording_studio.embeddable.management.floating.save", default: "Save launcher"),
          style: :primary,
          type: "submit"
        ) %>
      <% end %>
    </div>

    <div>
      <%= render FlatPack::PageTitle::Component.new(
        title: t("recording_studio.embeddable.management.floating.preview_title", default: "Visitors see this"),
        subtitle: recordable_title,
        variant: :h2
      ) %>
      <%= recording_studio_floating_widget(recording: @recording, preview: true) %>
    </div>
  <% end %>
</div>

<script>
  const syncLauncherPreview = () => {
    const widget = document.querySelector("[data-recording-studio-widget-stage] [data-recording-studio-widget]");
    if (!widget) return;

    const form = document.getElementById("launcher-settings");
    const value = (name) => form?.querySelector(`[name="${name}"]`)?.value;
    const position = value("embed[floating][position]");
    if (position === "bottom-left" || position === "bottom-right") {
      widget.setAttribute("data-position", position);
    }
    const edge = Number(value("embed[floating][edge_spacing]"));
    const width = Number(value("embed[floating][popup_width]"));
    const height = Number(value("embed[floating][popup_height]"));
    if (Number.isFinite(edge)) widget.style.setProperty("--rsw-edge", `${edge}px`);
    if (Number.isFinite(width)) widget.style.setProperty("--rsw-width", `${width}px`);
    if (Number.isFinite(height)) widget.style.setProperty("--rsw-height", `${height}px`);
  };

  document.getElementById("launcher-settings")?.addEventListener("input", syncLauncherPreview);
  document.getElementById("launcher-settings")?.addEventListener("change", syncLauncherPreview);
</script>
