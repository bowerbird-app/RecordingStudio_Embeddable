<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || "Embedded recording" %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) do |component| %>
    <% component.right_slot do %>
      <div class="flex items-center gap-2">
        <%= render FlatPack::Button::Component.new(
          text: "Embed",
          style: :secondary,
          size: :md,
          url: edit_management_embed_path(@embed)
        ) %>
        <%= render FlatPack::Button::Component.new(
          icon: "cog-6-tooth",
          icon_only: true,
          style: :secondary,
          size: :md,
          url: settings_management_embed_path(@embed),
          aria: { label: "Settings" }
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: "Styling",
          style: :secondary,
          size: :md,
          url: styling_management_embed_path(@embed)
        ) %>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Stats",
    subtitle: recordable_title,
    variant: :h1,
    large_subtitle: true
  ) %>

  <%= render FlatPack::Chart::Component.new(
    title: "Total views",
    type: :line,
    height: 320,
    series: @stats_chart_series,
    options: {
      xaxis: {
        categories: @stats_chart_categories
      },
      yaxis: {
        min: 0,
        forceNiceScale: true
      }
    }
  ) do |chart| %>
    <% chart.actions do %>
      <%= render FlatPack::ChartButtons::Component.new do |controls| %>
        <% @stats_range_options.each do |key, label| %>
          <% controls.button(
            text: label,
            url: stats_management_embed_path(@embed, range: key, viewer: @stats_viewer_filter),
            selected: !@stats_custom_range && @stats_range == key
          ) %>
        <% end %>

        <% controls.dropdown(
          text: @stats_viewer_options.fetch(@stats_viewer_filter),
          options: @stats_viewer_options.map do |key, label|
            query = if @stats_custom_range
                      { from: @stats_from_date, to: @stats_to_date, viewer: key }
                    else
                      { range: @stats_range, viewer: key }
                    end
            {
              text: label,
              url: stats_management_embed_path(@embed, query),
              selected: @stats_viewer_filter == key
            }
          end
        ) %>
      <% end %>

      <%= form_with url: stats_management_embed_path(@embed), method: :get, local: true, class: "mt-2 flex flex-wrap items-end gap-2" do %>
        <%= hidden_field_tag :viewer, @stats_viewer_filter %>
        <%= render FlatPack::DateInput::Component.new(
          name: :from,
          value: @stats_from_date&.iso8601,
          max: @stats_to_date&.iso8601,
          class: "w-36 h-8 py-1 text-xs"
        ) %>
        <%= render FlatPack::DateInput::Component.new(
          name: :to,
          value: @stats_to_date&.iso8601,
          min: @stats_from_date&.iso8601,
          class: "w-36 h-8 py-1 text-xs"
        ) %>
        <%= render FlatPack::Button::Component.new(text: "Apply", style: :secondary, size: :sm, type: "submit") %>
        <% if @stats_custom_range %>
          <%= render FlatPack::Button::Component.new(
            text: "Clear",
            style: :secondary,
            size: :sm,
            url: stats_management_embed_path(@embed, range: @stats_range, viewer: @stats_viewer_filter)
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
