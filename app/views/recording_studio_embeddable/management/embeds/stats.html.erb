<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || "Embedded recording" %>
<% summary = RecordingStudioEmbeddable::View.summary_for(@embed) %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) do |component| %>
    <% component.right_slot do %>
      <div class="flex items-center gap-2">
        <%= render FlatPack::Button::Component.new(
          text: "Embed",
          style: :secondary,
          size: :md,
          url: edit_management_embed_path(@embed)
        ) %>
        <%= render FlatPack::Button::Component.new(
          icon: "cog-6-tooth",
          icon_only: true,
          style: :secondary,
          size: :md,
          url: settings_management_embed_path(@embed),
          aria: { label: "Settings" }
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: "Styling",
          style: :secondary,
          size: :md,
          url: styling_management_embed_path(@embed)
        ) %>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Stats",
    subtitle: recordable_title,
    variant: :h1,
    large_subtitle: true
  ) %>

  <div class="space-y-3 pb-2">
    <h2 class="text-base font-semibold">View summary</h2>
    <div class="grid gap-2 text-sm sm:grid-cols-2">
      <p><strong>Total:</strong> <%= summary[:total] %></p>
      <p><strong>Humans:</strong> <%= summary[:humans] %></p>
      <p><strong>Bots:</strong> <%= summary[:bots] %></p>
      <p><strong>Unique visitors:</strong> <%= summary[:unique_visitors] %></p>
    </div>
  </div>
</div>
