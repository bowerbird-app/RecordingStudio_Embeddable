<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || t("recording_studio.embeddable.common.embedded_recording", default: "Embedded recording") %>

<% content_for :title, t("recording_studio.embeddable.management.stats.title", default: "Stats") %>
<% content_for :subtitle, recordable_title %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_href: edit_management_embed_path(@embed),
  back_tooltip: t("recording_studio.embeddable.common.embed", default: "Embed"),
  anchor_href: main_app.root_path,
  anchor_tooltip: t("recording_studio.embeddable.common.close", default: "Close")
) %>

<div class="flex w-full flex-col gap-6">

  <%= render "section_nav" %>

  <%= render FlatPack::Chart::Component.new(
    title: t("recording_studio.embeddable.management.stats.views", default: "Views"),
    type: :line,
    height: 320,
    series: @stats_chart_series,
    options: {
      xaxis: {
        categories: @stats_chart_categories
      },
      yaxis: {
        min: 0,
        forceNiceScale: true
      }
    }
  ) do |chart| %>
    <% chart.top_right_slot do %>
      <%= render FlatPack::ChartButtons::Component.new do |controls| %>
        <% controls.dropdown(
          text: (@stats_range_picker == "custom" ? t("recording_studio.embeddable.management.stats.range", default: "Range") : @stats_range_options.fetch(@stats_range)),
          options: @stats_range_options.map do |key, label|
            {
              text: label,
              url: recording_studio_embeddable_management_screen_path(@embed, :stats, range: key, viewer: @stats_viewer_filter,
                                                       granularity: @stats_granularity),
              selected: @stats_range_picker == key
            }
          end + [
            {
              text: t("recording_studio.embeddable.management.stats.range", default: "Range"),
              url: recording_studio_embeddable_management_screen_path(@embed, :stats, range: "custom", viewer: @stats_viewer_filter,
                                                       granularity: @stats_granularity),
              selected: @stats_range_picker == "custom"
            }
          ]
        ) %>

        <% controls.dropdown(
          text: @stats_viewer_options.fetch(@stats_viewer_filter),
          options: @stats_viewer_options.map do |key, label|
            query = if @stats_custom_range
                      { from: @stats_from_date, to: @stats_to_date, viewer: key, range: "custom",
                        granularity: @stats_granularity }
                    elsif @stats_range_picker == "custom"
                      { range: "custom", viewer: key, granularity: @stats_granularity }
                    else
                      { range: @stats_range, viewer: key, granularity: @stats_granularity }
                    end
            {
              text: label,
              url: recording_studio_embeddable_management_screen_path(@embed, :stats, **query),
              selected: @stats_viewer_filter == key
            }
          end
        ) %>

        <% controls.dropdown(
          text: @stats_granularity_options.fetch(@stats_granularity),
          options: @stats_granularity_options.map do |key, label|
            query = if @stats_custom_range
                      { from: @stats_from_date, to: @stats_to_date, viewer: @stats_viewer_filter, range: "custom",
                        granularity: key }
                    elsif @stats_range_picker == "custom"
                      { range: "custom", viewer: @stats_viewer_filter, granularity: key }
                    else
                      { range: @stats_range, viewer: @stats_viewer_filter, granularity: key }
                    end
            {
              text: label,
              url: recording_studio_embeddable_management_screen_path(@embed, :stats, **query),
              selected: @stats_granularity == key
            }
          end
        ) %>
      <% end %>

      <% if @stats_range_picker == "custom" %>
        <%= form_with url: recording_studio_embeddable_management_screen_path(@embed, :stats), method: :get, local: !recording_studio_embeddable_management_modal_request?, class: "mt-2 flex flex-col items-start gap-3", data: recording_studio_embeddable_management_form_data do %>
          <%= recording_studio_embeddable_management_variant_field %>
          <%= hidden_field_tag :viewer, @stats_viewer_filter %>
          <%= hidden_field_tag :range, "custom" %>
          <%= hidden_field_tag :granularity, @stats_granularity %>
          <%= render FlatPack::DateInput::Component.new(
            name: :from,
            label: t("recording_studio.embeddable.management.stats.from", default: "From"),
            value: @stats_from_date&.iso8601,
            max: @stats_to_date&.iso8601
          ) %>
          <%= render FlatPack::DateInput::Component.new(
            name: :to,
            label: t("recording_studio.embeddable.management.stats.to", default: "To"),
            value: @stats_to_date&.iso8601,
            min: @stats_from_date&.iso8601
          ) %>
          <%= render FlatPack::Button::Component.new(text: t("recording_studio.embeddable.common.apply", default: "Apply"), style: :primary, size: :sm, type: "submit") %>
          <% if @stats_custom_range %>
            <%= render FlatPack::Button::Component.new(
              text: t("recording_studio.embeddable.common.clear", default: "Clear"),
              style: :secondary,
              size: :sm,
              href: recording_studio_embeddable_management_screen_path(@embed, :stats, range: "custom", viewer: @stats_viewer_filter,
                                                       granularity: @stats_granularity)
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <section class="overflow-hidden rounded-lg border border-(--surface-border-color) bg-(--surface-background-color)">
    <div class="border-b border-(--surface-border-color) px-4 py-3">
      <h2 class="text-sm font-semibold text-(--surface-content-color)"><%= t("recording_studio.embeddable.management.stats.countries", default: "Countries") %></h2>
    </div>

    <% if @stats_geo_rows.present? %>
      <%= render FlatPack::Table::Component.new(
        data: @stats_geo_rows,
        dividers: true,
        style: :plain
      ) do |table| %>
        <% table.column(
          title: t("recording_studio.embeddable.management.stats.country", default: "Country"),
          html: ->(row) {
            row[:country] == "Unknown" ? t("recording_studio.embeddable.management.stats.unknown_country", default: "Unknown") : row[:country]
          }
        ) %>
        <% table.column(
          title: t("recording_studio.embeddable.management.stats.views", default: "Views"),
          html: ->(row) { row[:views].to_s }
        ) %>
        <% table.column(
          title: t("recording_studio.embeddable.management.stats.unique_views", default: "Unique views"),
          html: ->(row) { row[:unique_views].to_s }
        ) %>
        <% table.column(
          title: t("recording_studio.embeddable.management.stats.human_views", default: "Human views"),
          html: ->(row) { row[:human_views].to_s }
        ) %>
        <% table.column(
          title: t("recording_studio.embeddable.management.stats.bot_views", default: "Bot views"),
          html: ->(row) { row[:bot_views].to_s }
        ) %>
      <% end %>
    <% else %>
      <p class="px-4 py-4 text-sm text-(--surface-muted-content-color)">
        <%= t("recording_studio.embeddable.management.stats.empty_geo", default: "No geo access data for this filter and date range.") %>
      </p>
    <% end %>
  </section>
</div>
