<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || "Embedded recording" %>
<% embed_code = parent_recording&.embed_code(host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>
<% summary = RecordingStudioEmbeddable::View.summary_for(@embed) %>
<% embed_options = RecordingStudioEmbeddable::Renderer.options_for(parent_recording) %>
<% publishable_required = ActiveModel::Type::Boolean.new.cast(embed_options.fetch(:require_publishable, RecordingStudioEmbeddable.configuration.require_publishable)) %>
<% publishable_ready = if parent_recording.respond_to?(:currently_published?)
     parent_recording.currently_published?
   elsif parent_recording.respond_to?(:current_publishable)
     parent_recording.current_publishable.present?
   elsif parent_recording.respond_to?(:publishable_child_recording)
     parent_recording.publishable_child_recording.present?
   else
     false
   end %>
<% show_unpublished_warning = publishable_required && !publishable_ready %>
<% disable_embed_form = show_unpublished_warning %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Embed",
    subtitle: recordable_title,
    variant: :h1,
    large_subtitle: true
  ) %>

  <% if show_unpublished_warning %>
    <%= render FlatPack::Alert::Component.new(
      title: "This page is not published",
      description: "Publish this page first before using its embed.",
      style: :warning
    ) %>
  <% end %>

  <%= form_with model: @embed, url: management_embed_path(@embed), method: :patch, class: "space-y-6" do |_form| %>
    <fieldset <%= "disabled" if disable_embed_form %> class="space-y-6 <%= "opacity-60" if disable_embed_form %>">
    <div class="embed-enabled-switch">
      <%= render FlatPack::Switch::Component.new(
        name: "embed[enabled]",
        label: "Enabled",
        checked: @embed.enabled,
        disabled: disable_embed_form
      ) %>
    </div>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <div class="space-y-3">
        <h2 class="text-base font-semibold">Embed code</h2>
        <textarea readonly rows="6" class="w-full rounded-md border border-(--surface-border-color) bg-(--surface-raised-background-color) p-3 font-mono text-sm"><%= embed_code %></textarea>
      </div>
    <% end %>
  <% end %>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <div class="space-y-3">
        <h2 class="text-base font-semibold">View summary</h2>
        <div class="grid gap-2 text-sm sm:grid-cols-2">
          <p><strong>Total:</strong> <%= summary[:total] %></p>
          <p><strong>Humans:</strong> <%= summary[:humans] %></p>
          <p><strong>Bots:</strong> <%= summary[:bots] %></p>
          <p><strong>Unique visitors:</strong> <%= summary[:unique_visitors] %></p>
        </div>
      </div>
    <% end %>
  <% end %>

    <% if @embed.errors.any? %>
      <p role="alert" class="text-sm text-red-700"><%= @embed.errors.full_messages.to_sentence %></p>
    <% end %>

    <%= render FlatPack::Accordion::Component.new do |accordion| %>
      <% accordion.item(id: "embed-domain-controls", title: "Domain controls") do %>
        <div class="space-y-4">
          <%= render FlatPack::TextArea::Component.new(
            name: "embed[allowed_embedder_domains_text]",
            label: "Allowed domains (one per line)",
            value: @embed.allowed_domains.join("\n"),
            rows: 6,
            placeholder: "example.com",
            disabled: disable_embed_form
          ) %>

          <%= render FlatPack::TextArea::Component.new(
            name: "embed[blocked_embedder_domains_text]",
            label: "Blocked domains (one per line)",
            value: @embed.blocked_domains.join("\n"),
            rows: 6,
            placeholder: "bad-domain.example",
            disabled: disable_embed_form
          ) %>
        </div>
      <% end %>
    <% end %>

    <%= render FlatPack::Button::Component.new(
      text: "Save changes",
      style: :primary,
      size: :md,
      type: "submit",
      disabled: disable_embed_form
    ) %>
    </fieldset>
  <% end %>
</div>

<style>
  .embed-enabled-switch input.peer:not(:checked) + [role="switch"] {
    background-color: var(--switch-track-background-color) !important;
  }

  .embed-enabled-switch input.peer:checked + [role="switch"] {
    background-color: var(--switch-track-checked-background-color) !important;
  }
</style>
