<% parent_recording = @embed.parent_recording %>
<% recordable = parent_recording&.recordable %>
<% recordable_title = recordable.try(:title).presence || recordable.try(:name).presence || "Embedded recording" %>
<% embed_code = parent_recording&.embed_code(host: request.host_with_port, protocol: request.protocol.delete_suffix("://")) %>
<% embed_options = RecordingStudioEmbeddable::Renderer.options_for(parent_recording) %>
<% publishable_required = ActiveModel::Type::Boolean.new.cast(embed_options.fetch(:require_publishable, RecordingStudioEmbeddable.configuration.require_publishable)) %>
<% publishable_ready = if parent_recording.respond_to?(:currently_published?)
     parent_recording.currently_published?
   elsif parent_recording.respond_to?(:current_publishable)
     parent_recording.current_publishable.present?
   elsif parent_recording.respond_to?(:publishable_child_recording)
     parent_recording.publishable_child_recording.present?
   else
     false
   end %>
<% show_unpublished_warning = publishable_required && !publishable_ready %>
<% publish_page_url = parent_recording.present? ? recording_studio_publishable.edit_recording_publishable_path(recording_id: parent_recording.id) : nil %>
<% disable_management_actions = show_unpublished_warning %>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(anchor_url: main_app.root_path) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: "Embed",
    subtitle: recordable_title,
    variant: :h1,
    large_subtitle: true
  ) %>

  <div class="flex flex-wrap items-center gap-2">
    <%= render FlatPack::Button::Component.new(
      text: "Preview",
      style: :secondary,
      size: :md,
      url: preview_management_embed_path(@embed)
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Styling",
      style: :secondary,
      size: :md,
      url: disable_management_actions ? nil : styling_management_embed_path(@embed),
      type: "button",
      class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
      aria: (disable_management_actions ? { disabled: true } : {})
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Settings",
      style: :secondary,
      size: :md,
      url: disable_management_actions ? nil : settings_management_embed_path(@embed),
      type: "button",
      class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
      aria: (disable_management_actions ? { disabled: true } : {})
    ) %>
    <%= render FlatPack::Button::Component.new(
      text: "Stats",
      style: :secondary,
      size: :md,
      url: disable_management_actions ? nil : stats_management_embed_path(@embed),
      type: "button",
      class: (disable_management_actions ? "pointer-events-none opacity-50" : nil),
      aria: (disable_management_actions ? { disabled: true } : {})
    ) %>
  </div>

  <% if show_unpublished_warning %>
    <%= render FlatPack::EmptyState::Component.new(
      title: "Embeddable unavailable",
      description: "You need to publish this page before you can enable embeddable."
    ) do |empty| %>
      <% empty.actions do %>
        <% if publish_page_url.present? %>
          <%= link_to publish_page_url, class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: "Publish Settings", style: :primary) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="space-y-6">
      <%= form_with model: @embed, url: management_embed_path(@embed), method: :patch, class: "embed-enabled-switch" do |_form| %>
        <input type="hidden" name="embed[enabled]" value="0">
        <%= render FlatPack::Switch::Component.new(
          name: "embed[enabled]",
          label: "Embeddable",
          checked: @embed.enabled,
          disabled: show_unpublished_warning,
          data: { autosave_embed_enabled: true }
        ) %>
      <% end %>

      <div class="space-y-4">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="space-y-1">
            <h2 class="text-base font-semibold">Embed code</h2>
            <p class="max-w-2xl text-sm text-(--text-muted-color)">
              Copy the code below, then paste it into the page or editor on your site where you want the embed to appear.
              Save that page after you paste it.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <%= render FlatPack::Button::Component.new(
              text: "Copy code",
              style: :secondary,
              size: :sm,
              type: "button",
              data: { embed_code_copy_button: true }
            ) %>
          </div>
        </div>

        <textarea
          id="embed-code"
          readonly
          rows="6"
          class="w-full rounded-md border border-(--surface-border-color) bg-(--surface-raised-background-color) p-3 font-mono text-sm"
          data-embed-code-target="code"
        ><%= embed_code %></textarea>
      </div>
    </div>
  <% end %>
</div>

<style>
  .embed-enabled-switch input.peer:not(:checked) + [role="switch"] {
    background-color: var(--switch-track-background-color) !important;
  }

  .embed-enabled-switch input.peer:checked + [role="switch"] {
    background-color: var(--switch-track-checked-background-color) !important;
  }
</style>

<script>
  const initializeEmbedToggleAutosave = () => {
    document.querySelectorAll('input[data-autosave-embed-enabled="true"]').forEach((input) => {
      if (input.dataset.autosaveBound === "true") {
        return;
      }

      input.dataset.autosaveBound = "true";
      input.addEventListener("change", () => {
        input.form?.requestSubmit();
      });
    });
  };

  const initializeEmbedCodeCopy = () => {
    document.querySelectorAll('button[data-embed-code-copy-button="true"]').forEach((button) => {
      if (button.dataset.copyBound === "true") {
        return;
      }

      button.dataset.copyBound = "true";

      button.addEventListener("click", async () => {
        const container = button.closest(".space-y-4") || document;
        const code = container.querySelector('[data-embed-code-target="code"]');
        if (!code) return;

        const text = code.value || code.textContent || "";

        try {
          await navigator.clipboard.writeText(text);
          const previousLabel = button.textContent;
          button.textContent = "Copied!";
          window.setTimeout(() => {
            button.textContent = previousLabel;
          }, 1500);
        } catch (_error) {
          code.focus();
          code.select();
        }
      });
    });
  };

  document.addEventListener("turbo:load", initializeEmbedToggleAutosave);
  document.addEventListener("DOMContentLoaded", initializeEmbedToggleAutosave);
  document.addEventListener("turbo:load", initializeEmbedCodeCopy);
  document.addEventListener("DOMContentLoaded", initializeEmbedCodeCopy);
</script>
